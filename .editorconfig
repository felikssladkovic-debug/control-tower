# EditorConfig is awesome: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yaml,yml,json,jsonc,vue,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.{gradle,xml}]
indent_size = 4

[*.bat]
end_of_line = crlf
